---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Chat from "../components/Chat.astro";
import KnowledgeBase from "../components/KnowledgeBase.astro";
---

<Base
  title="LoL Glossary Chatbot"
  description="A retrieval-augmented chatbot for League of Legends terminology. Course project, UNAB 2026."
>
  <Header />
  <main id="main" class="page">
    <Chat />
    <KnowledgeBase />
  </main>
  <footer class="site-footer">
    <p>
      Student project (UNAB, Santiago, Chile, 2026). Answers come from a Spanish glossary and may be incomplete.
    </p>
    <p>
      Not endorsed by Riot Games. League of Legends is a trademark of Riot Games, Inc.
    </p>
  </footer>
  <script>
    import "../scripts/app.ts";
  </script>
</Base>
