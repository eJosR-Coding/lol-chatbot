---
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="LoL Glossary Chatbot, home">
      <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
        <polygon points="32,4 56,18 56,46 32,60 8,46 8,18" />
        <path d="M26 27.5c0-3.6 2.7-6 6.2-6s6.1 2.2 6.1 5.4c0 2.4-1.4 3.7-3.2 4.8-1.5.9-2.1 1.6-2.1 3.1" />
        <circle cx="33" cy="41.5" r="1.9" />
      </svg>
      <span class="brand__name">LoL Glossary</span>
    </a>

    <div class="tabs" role="tablist" aria-label="Views">
      <button class="tab" role="tab" id="tab-chat" aria-selected="true" aria-controls="view-chat" data-view="chat">
        Chat
      </button>
      <button class="tab" role="tab" id="tab-kb" aria-selected="false" aria-controls="view-kb" data-view="kb" tabindex="-1">
        Knowledge base
      </button>
    </div>

    <p class="status" id="status" data-state="checking" role="status">
      <span class="status__dot" aria-hidden="true"></span>
      <span id="status-text">Checking backend…</span>
    </p>
  </div>
</header>
